# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it.
#
# All four come from App Store Connect → Users and Access → Integrations → Keys.

# The 10-character code shown beside the key (also in the AuthKey_<KeyID>.p8 filename).
ASC_KEY_ID=

# The UUID above the key table — the same for every key in your team.
ASC_ISSUER_ID=

# Optional: pre-fills the fields in the UI so you don't retype them.
ASC_KEY_PATH=~/private_keys/AuthKey_XXXXXXXXXX.p8
ASC_BUNDLE_ID=com.example.myapp
